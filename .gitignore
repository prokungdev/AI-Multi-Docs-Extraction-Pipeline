# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.mypy_cache/
venv/
.venv/
ENV/
env/

# Environments
.env

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# Local Pipeline Logs (keep directory structure but ignore text files)
logs/*
!logs/.gitkeep

# Local Staging & Pipeline Storage
# Ignore all storage runtime contents by default
storage/**
!storage/
!storage/**/
!storage/**/.gitkeep

# Ignore dynamic company workspaces created at runtime
storage/companies/*

# Explicitly keep and track C00000_SAMPLE template workspace and sample assets
!storage/companies/C00000_SAMPLE/
!storage/companies/C00000_SAMPLE/**

# Exclude SQLite Database files explicitly
storage/**/pipeline.db
storage/**/*.db



# Output exports
outputs/*
!outputs/.gitkeep

# Web (Next.js) & Frontend dependencies
node_modules/
.next/
out/
.turbo/
.npm
dist/

# Mobile (Flutter / React Native)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
android/app/build/
ios/Pods/
.expo/
