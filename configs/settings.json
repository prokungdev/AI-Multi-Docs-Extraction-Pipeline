{
  "storage_root": "pipeline_storage",
  "active_domains": [
    "expense_receipt"
  ],
  "pipeline_folders": [
    "01_raw_inbox",
    "02_split_pages",
    "03_processing_queue",
    "04_archive"
  ],
  "max_images_per_request": 50,
  "concurrency": {
    "default": 4,
    "models": {
      "gemini-3.5-flash": 8,
      "gemini-2.5-flash": 6,
      "gemini-3.5-flash-free": 2
    }
  },
  "logging": {
    "logs_dir": "logs",
    "rotation": "00:00",
    "retention": "30 days",
    "compression": "zip",
    "level": "INFO"
  },
  "archiving": {
    "keep_split_pages": true,
    "split_format": "pdf, png",
    "filename_pattern": "{domain}_{source}_{doc_no}_{page_no}",
    "use_ai_fallback_matching": true
  },
  "ai_provider": {
    "active_provider": "gemini",
    "gemini": {
      "model_name": "gemini-3.5-flash",
      "api_key_env": "GEMINI_API_KEY"
    },
    "openai": {
      "model_name": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY"
    }
  }
}
