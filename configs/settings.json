{
  "app_name": "AI Multi-Docs Extraction Pipeline",
  "app_version": "1.0.0",
  "app_description": "RESTful API Backend & Pipeline Engine for Document Extraction",
  "storage_root": "storage",
  "default_company_code": "C00000_SAMPLE",
  "pipeline_folders": [
    "01_drop_zone",
    "02_raw_data",
    "03_preprocess",
    "04_processing",
    "05_archive",
    "06_output"
  ],
  "doc_types": [
    {
      "doc_type_id": "expense_receipt",
      "display_name": "ใบเสร็จรับเงินค่าใช้จ่าย (Expense Receipt)",
      "is_active": true,
      "sort_order": 1,
      "files": {
        "classify_prompt": "classify-prompt.txt",
        "classify_schema": "classify-schema.json",
        "extract_prompt": "extract-prompt.txt",
        "extract_schema": "extract-schema.json",
        "extract_rules": "extract-rules.json"
      }
    },
    {
      "doc_type_id": "tax_invoice",
      "display_name": "ใบกำกับภาษีเต็มรูป (Tax Invoice)",
      "is_active": true,
      "sort_order": 2,
      "files": {
        "classify_prompt": "classify-prompt.txt",
        "classify_schema": "classify-schema.json",
        "extract_prompt": "extract-prompt.txt",
        "extract_schema": "extract-schema.json",
        "extract_rules": "extract-rules.json"
      }
    },
    {
      "doc_type_id": "withholding_tax",
      "display_name": "หนังสือรับรองการหักภาษี ณ ที่จ่าย (Withholding Tax 50 ทวิ)",
      "is_active": true,
      "sort_order": 3,
      "files": {
        "classify_prompt": "classify-prompt.txt",
        "classify_schema": "classify-schema.json",
        "extract_prompt": "extract-prompt.txt",
        "extract_schema": "extract-schema.json",
        "extract_rules": "extract-rules.json"
      }
    }
  ],
  "logging": {
    "logs_dir": "logs",
    "rotation": "00:00",
    "retention": "30 days",
    "compression": "zip",
    "level": "INFO"
  },
  "image_processing": {
    "supported_input_extensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".tiff"
    ],
    "processing_format": "jpg",
    "jpeg_quality": 85,
    "max_dimension": 1800,
    "dpi": 150,
    "split_filename_pattern": "{doc_type}_{tax_id}_{original_filename}_{batch_id}_p{page_no}",
    "archive_filename_pattern": "{doc_type}_{tax_id}_{doc_no}_{batch_id}_p{page_no}",
    "use_ai_fallback_matching": true
  },
  "validation_thresholds": {
    "confidence_high": 0.85,
    "confidence_low": 0.60,
    "confidence_review": 0.70,
    "financial_tolerance": 0.05
  },
  "ai_provider": {
    "active_provider": "gemini",
    "billing_tier": "free",
    "max_retries": 3,
    "max_images_per_request": 50,
    "gemini": {
      "model_name": "gemini-3.5-flash",
      "api_key_env": "GEMINI_API_KEY_FREE",
      "billing_tier": "free",
      "max_concurrent_requests": 8
    },
    "openai": {
      "model_name": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY",
      "billing_tier": "paid",
      "max_concurrent_requests": 3
    }
  },
  "ai_pricing": {
    "exchange_rate_thb": 36.0,
    "models": {
      "gemini-3.5-flash": {
        "input_per_million": 0.075,
        "output_per_million": 0.3
      }
    }
  },
  "database": {
    "active_driver": "sqlite",
    "echo_sql": false,
    "sqlite": {
      "db_filename": "database/pipeline.db"
    },
    "postgresql": {
      "url_env": "DATABASE_URL",
      "pool_size": 10,
      "max_overflow": 20,
      "pool_recycle": 3600,
      "pool_pre_ping": true
    }
  }
}