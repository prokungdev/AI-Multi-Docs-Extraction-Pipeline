# 1. AI Master Credentials (matches AIModelConfig.api_key_env_var in database)
api_key_env_default_free="your_gemini_free_api_key_here"
api_key_env_default_paid="your_gemini_paid_api_key_here"

# 2. Database Connection (matches database.postgresql.url_env)
# Default is local SQLite (storage/pipeline.db). Set DATABASE_URL below only when using PostgreSQL (Production).
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/ai_pipeline_db?sslmode=require
